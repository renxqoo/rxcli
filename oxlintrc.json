{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-explicit-any": "warn"
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/*.config.{js,ts,mjs,cjs}"]
}
