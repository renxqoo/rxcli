{
  "name": "@renxqoo/rxcordys-cli",
  "version": "1.2.0",
  "description": "rxcordys — Cordys CRM full Lead-to-Cash (L2C) agent CLI (leads, accounts, opportunities, contracts, payments, invoices, orders, approvals, stats), built on @renxqoo/agent-data-cli",
  "keywords": [
    "agent",
    "agent-data-cli",
    "cli",
    "cordys",
    "crm",
    "rxcordys"
  ],
  "homepage": "https://github.com/renxqoo/rxcli/tree/main/apps/cordys-crm#readme",
  "bugs": {
    "url": "https://github.com/renxqoo/rxcli/issues"
  },
  "license": "MIT",
  "author": "renxqoo <wangrenren611@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renxqoo/rxcli.git",
    "directory": "apps/cordys-crm"
  },
  "bin": {
    "rxcordys": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bin": "bun build ./src/index.ts --compile --minify --outfile dist/rxcordys",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@renxqoo/agent-data-cli": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "rxcli": {
    "plugin": true
  }
}
