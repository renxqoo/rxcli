{
  "name": "rxcli-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "rxcli v2 — agent-native CLI framework (cli-sdk base package + business packages)",
  "license": "MIT",
  "author": "renxqoo",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "publish": "node scripts/publish.mjs",
    "publish:dry-run": "node scripts/publish.mjs --dry-run",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "docs:check": "pnpm --filter @renxqoo/agent-data-cli docs:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@9.0.0"
}
